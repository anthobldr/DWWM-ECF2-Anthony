{% if selectedTrainee %}
    <div class="modal fade" id="addAbsenceModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5>Saisir une absence</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="POST" action="{{ path('app_absence_new') }}" enctype="multipart/form-data" data-turbo="false">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <img src="{% if selectedTrainee.photoFilename %}{{ asset('uploads/photos/' ~ selectedTrainee.photoFilename) }}{% else %}https://i.pravatar.cc/200?img={{ selectedTrainee.id }}{% endif %}" 
                                        width="100px" class="rounded-4">
                                    <div class="d-flex flex-column">
                                        <h6>{{ selectedTrainee.firstName }} {{ selectedTrainee.lastName }}</h6>
                                        <small class="text-secondary">Titre profesionnel<br />Développeur web & web mobile</small>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label for="notes" class="form-label">Notes (optionnel)</label>
                                    <textarea name="notes" id="notes" maxlength="500" placeholder="Ex: Fièvre, consultation médicale..." class="form-control"></textarea>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <input type="hidden" name="trainee_id" value="{{ selectedTrainee.id }}">
                            
                                <div class="mb-3">
                                    <label for="reason" class="form-label">Type d'absence <span class="text-danger">*</span></label>
                                    <select class="form-select" id="reason" name="reason" required>
                                        <option value="">Sélectionner un motif</option>
                                        <option value="maladie">Maladie</option>
                                        <option value="sans_motif">Sans motif</option>
                                        <option value="legale">Absence légale</option>
                                        <option value="accident">Accident du travail</option>
                                    </select>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <label for="start_date" class="form-label">Date de début <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control border" id="start_date" name="start_date" required>
                                    </div>
                                    <div class="col-lg-6">
                                        <label for="end_date" class="form-label">Date de fin</label>
                                        <input type="date" class="form-control border" id="end_date" name="end_date">
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label for="justificative" class="form-label">Justificatif PDF (optionnel)</label>
                                    <input type="file" class="form-control border" id="justificative" name="justificative" accept=".pdf">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-top pt-3">
                        <button type="button" class="btn btn-outline-danger rounded-3" data-bs-dismiss="modal">
                            Annuler
                        </button>
                        <button type="submit" class="btn btn-success rounded-3 px-3">
                            Ajouter l'absence
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}