<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil - AFPA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-dark bg-white sticky-top border-bottom">
            <div class="container-fluid">
                <div class="d-flex align-items-center gap-3 ms-3">
                    <img src="/images/logo.jpeg" width="40%"/>
                    <span class="lh-1">La formation <br />pour avancer</span>
                </div>
                {% if app.user %}
                    <div class="d-flex gap-2 align-items-center me-5">
                        <img src="/icons/user.svg" width="50px"/>
                        <div class="dropdown">
                            <button class="d-flex flex-column btn border-0 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="fw-bold me-3">{{ app.user.username }}</span>
                                <small class="lh-1">Administrateur</small>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_admin_dashboard') }}">Tableau de bord</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a></li>
                            </ul>
                        </div>
                    </div>
                {% else %}
                    <div class="me-5">
                        <button class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Connexion Admin
                        </button>
                    </div>
                {% endif %}
            </div>
        </nav>
    </header>

    <main class="container">
        <div class="mb-3 py-3 lh-1">
            <h1 class="display-4 fw-bold mb-3">Gestion des Absences</h1>
            <p class="lead text-muted">Plateforme de suivi des absences des stagiaires AFPA Bégles</p>
        </div>
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-people-fill text-primary" style="font-size: 2.5rem;"></i>
                        <h6 class="mt-2 mb-2 text-muted">Stagiaires</h6>
                        <h2 class="text-primary fw-bold">{{ totalTrainees }}</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-calendar-x text-danger" style="font-size: 2.5rem;"></i>
                        <h6 class="mt-2 mb-2 text-muted">Absences</h6>
                        <h2 class="text-danger fw-bold">{{ totalAbsences }}</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-cash-coin text-success" style="font-size: 2.5rem;"></i>
                        <h6 class="mt-2 mb-2 text-muted">Coût/Jour</h6>
                        <h2 class="text-success fw-bold">{{ (costPerDay)|number_format(2, ',', ' ') }}€</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>
                        <h6 class="mt-2 mb-2 text-muted">Perte Totale</h6>
                        <h2 class="text-warning fw-bold">{{ (totalLoss)|number_format(2, ',', ' ') }}€</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-success text-white rounded-top-3">
                        <h5>
                            Classement par Nombre d'Absences
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 10%">Photo</th>
                                        <th style="width: 25%">Nom</th>
                                        <th style="width: 15%">Total</th>
                                        <th style="width: 15%">Sans Motif</th>
                                        <th style="width: 20%">Perte</th>
                                        <th style="width: 10%">Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ranking, stats in traineesStats %}
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary rounded-pill">{{ ranking + 1 }}</span>
                                        </td>
                                        <td>
                                            <img src="{% if stats.photoFilename %}{{ asset('uploads/photos/' ~ stats.photoFilename) }}{% else %}https://i.pravatar.cc/100?img={{ stats.id }}{% endif %}" alt="{{ stats.firstName }}" width="40" height="40" class="rounded-circle">
                                        </td>
                                        <td>
                                            <span class="{% if stats.hasHighUnauthorized %}text-danger fw-bold{% endif %}">
                                                {{ stats.lastName }} {{ stats.firstName }}
                                            </span>
                                            {% if stats.hasHighUnauthorized %}
                                                <i class="bi bi-exclamation-circle-fill text-danger ms-2"></i>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-danger">{{ stats.absenceCount }}</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">{{ stats.unauthorizedAbsenceCount }}</span>
                                        </td>
                                        <td>
                                            <strong class="text-danger">{{ (stats.loss)|number_format(2, ',', ' ') }}€</strong>
                                        </td>
                                        <td>
                                            {% if stats.absenceCount == 0 %}
                                                <span class="badge bg-success">✓ OK</span>
                                            {% elseif stats.unauthorizedAbsenceCount > 5 %}
                                                <span class="badge bg-danger">⚠ Alerte</span>
                                            {% else %}
                                                <span class="badge bg-warning text-dark">⚠ Vigilance</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container-fluid">
            <small>&copy; 2026 AFPA Bégles - Formation pour Avancer</small>
        </div>
    </footer>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="loginModalLabel">
                        <i class="bi bi-lock-fill text-success me-2"></i>Connexion Admin
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="{{ path('app_login') }}" data-turbo="false">
                    <div class="modal-body">
                        {% if error %}
                        <div class="alert alert-danger mb-3">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                        {% endif %}
                        <div class="mb-3">
                            <label for="username" class="form-label fw-bold">Nom d'utilisateur</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                <input type="text" value="" name="_username" id="username" class="form-control border-start-0" placeholder="Ex: ADMINAFPA" autocomplete="username" required autofocus>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label fw-bold">Mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0">
                                    <i class="bi bi-key text-muted"></i>
                                </span>
                                <input type="password" name="_password" id="password" class="form-control border-start-0" placeholder="Entrez votre mot de passe" autocomplete="current-password" required>
                            </div>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="remember" name="_remember_me">
                            <label class="form-check-label" for="remember">
                                Se souvenir de moi
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light">
                        <button type="button" class="btn btn-outline-success" data-bs-dismiss="modal">
                            Annuler
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>